    },
    {
      "kind": "html",
      "text": "From Legal PDFs to Verifiable Answers",
      "effectivePt": 74
    },
    {
      "kind": "html",
      "text": "Answer quality, page-level grounding, and latency across 100 legal questions",
      "effectivePt": 32
    },
    {
      "kind": "html",
      "text": "github.com/SteinVR/Agentic-RAG-Challenge\n          Trends in Machine Learning II · Universität Trier",
